{
  "name": "honest-backend",
  "version": "1.0.0",
  "private": true,
  "description": "HONEST - backend API for a student accountability / promise-keeping application. Plan -> Promise -> Do -> Admit -> Reflect -> Start Again.",
  "main": "server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node tests/run.js",
    "verify": "node scripts/verify-api.js",
    "verify:client": "node scripts/verify-client-contract.js",
    "verify:turso": "node scripts/verify-turso.js",
    "verify:vercel": "node scripts/verify-vercel-entry.js",
    "verify:all": "node tests/run.js && node scripts/verify-turso.js && node scripts/verify-vercel-entry.js",
    "smoke": "node scripts/smoke.js",
    "audit": "node scripts/audit-unused.js && node scripts/audit-exports.js",
    "reset-db": "node scripts/reset-db.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "keywords": [
    "honest",
    "accountability",
    "promises",
    "express",
    "sqlite"
  ],
  "license": "MIT"
}
