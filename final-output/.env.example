# HONEST backend - environment variables
#
# Copy to `.env` for local development, or set these in your hosting dashboard
# (Vercel → Settings → Environment Variables, Render → Environment, etc.).
# Never commit a filled-in copy: `.env` is git-ignored.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# HTTP port. Ignored on serverless platforms (they choose the port).
PORT=3000

# 'production' enables production behaviour and quieter diagnostics.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
#
# Persistent cloud SQLite (recommended for Vercel / any serverless platform).
# Create a database at https://turso.tech and copy the URL + token.
# When these are present they take priority over HONEST_DB below.
#
# TURSO_DATABASE_URL=libsql://honest-yourname.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...
#
# Aliases accepted for the same two values (useful with other libSQL hosts):
#   LIBSQL_URL / LIBSQL_AUTH_TOKEN / HONEST_TURSO_URL / HONEST_TURSO_AUTH_TOKEN

# Local SQLite file. Use this on a machine or a host with a persistent volume
# (Render disks, Railway volumes, Fly.io volumes, Docker bind mounts).
# Defaults to <project>/data/honest.db.
#
# HONEST_DB=./data/honest.db
#
# DATABASE_URL is accepted as an alias for HONEST_DB. Relative paths resolve
# against the working directory; ./data is created automatically if missing.
#
# DATABASE_URL=./data/honest.db
#
# Escape hatches:
#   HONEST_DB=:memory:          in-memory, nothing is persisted (tests only)
#   HONEST_DB_PERSISTENT=1      trust HONEST_DB even in a location that looks
#                               temporary (useful for custom volume paths)
#
# HONEST_DB_PERSISTENT=0
#
# The database directory is created if it does not exist. If the location is
# neither writable nor creatable, the backend falls back to a temporary file and
# prints a loud warning rather than crashing.

# ---------------------------------------------------------------------------
# Timezone
# ---------------------------------------------------------------------------
#
# IANA zone that every date-sensitive rule uses, or 'automatic' to follow the
# host clock. Defaults to automatic (the host's zone, e.g. Asia/Calcutta).
#
# HONEST_TIMEZONE=Asia/Calcutta

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
#
# Comma separated list of origins allowed to call the API from a browser.
# Defaults to '*' when not set. Patterns are supported:
#
#   ALLOWED_ORIGINS=https://honest.vercel.app,https://*.vercel.app,capacitor://localhost,https://localhost
#
# Requests without an Origin header (native Android clients, curl, uptime
# monitors, server-to-server cron) are always allowed: CORS protects browsers,
# it is not authentication.
#
ALLOWED_ORIGINS=*

# ---------------------------------------------------------------------------
# Serverless scheduler
# ---------------------------------------------------------------------------
#
# Shared secret for GET/POST /api/cron/tick. Generate one with:
#   openssl rand -hex 32
#
# CRON_SECRET=replace-with-a-long-random-value
#
# Vercel Cron sends this automatically as `Authorization: Bearer $CRON_SECRET`
# once the variable is set in the project. Other schedulers can send
# `x-cron-secret: <secret>` or `?secret=<secret>` instead.

# Disable the in-process background timer. Useful when the platform is
# serverless, or when an external scheduler owns the cadence.
#
# HONEST_DISABLE_SCHEDULER=1
#
# How often the in-process timer runs, in milliseconds (minimum 1000).
# HONEST_SCHEDULER_INTERVAL_MS=30000
#
# Run the in-process timer even on a platform that looks serverless. Only set
# this when the process genuinely stays alive (a container you control).
# HONEST_FORCE_TIMER_SCHEDULER=0

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Serve a frontend folder from the same origin (handy locally; unnecessary when
# the frontend is deployed separately).
# HONEST_FRONTEND_DIR=E:/APPP/frontend

# Log every SQL statement (development only).
# HONEST_SQL_LOG=0

# Suppress the start-up banner (serverless logs).
# HONEST_QUIET=1

# Shift "now" by N minutes. Simulation/testing only - never set in production.
# HONEST_TIME_OFFSET_MIN=0
